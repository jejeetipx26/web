# ============================================================
# CONTOH KONFIGURASI — salin menjadi `.env` lalu isi nilainya
# ============================================================

# Passphrase kunci server AES-GCM (harus SAMA dengan notebook)
# Kunci AES-256 diturunkan memakai PBKDF2-HMAC-SHA256 (200.000 iterasi).
# Gunakan passphrase minimal 16 karakter, jangan pakai kata yang mudah ditebak.
E_RECEIPT_SECRET_KEY=GANTI-KUNCI-RAHASIA-ANDA

# (Opsional) Salt PBKDF2 — boleh dibiarkan untuk memakai bawaan aplikasi.
# E_RECEIPT_KEY_SALT=e-receipt-stego-v1

# Akun admin generator
E_RECEIPT_ADMIN_USERNAME=admin
E_RECEIPT_ADMIN_PASSWORD=GANTI-PASSWORD-KUAT
